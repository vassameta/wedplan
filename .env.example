# Bind to localhost when using Nginx reverse proxy on the host
APP_BIND_IP=127.0.0.1
APP_PORT=3000

POSTGRES_DB=wedplan
POSTGRES_USER=wedplan
# Use a long alphanumeric password to avoid URL-encoding issues in DATABASE_URL
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Workspace login password
ADMIN_PASSWORD=replace_with_a_strong_password
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
