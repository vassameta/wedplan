generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  UNPAID
  DEPOSIT
  PAID
}

enum WorkspaceRole {\n  ADMIN\n  EDITOR\n  VIEWER\n}\n\nenum PlannerRecordKind {
  VENDOR
  GUEST
  TASK
  PAYMENT
}

model WorkspaceUser {\n  id           String        @id @default(cuid())\n  email        String        @unique\n  name         String\n  passwordHash String\n  role         WorkspaceRole @default(EDITOR)\n  isActive     Boolean       @default(true)\n  createdAt    DateTime      @default(now())\n  updatedAt    DateTime      @updatedAt\n}\n\nmodel WeddingPlan {
  id         String          @id @default(cuid())
  name       String
  partner    String          @default("")
  date       String          @default("")
  location   String          @default("")
  budget     Decimal         @default(0) @db.Decimal(18, 2)
  guestCount Int             @default(0)
  items      BudgetItem[]
  records    PlannerRecord[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([updatedAt])
}

model BudgetItem {
  id            String        @id
  name          String
  category      String
  vendor        String        @default("")
  planned       Decimal       @default(0) @db.Decimal(18, 2)
  actual        Decimal       @default(0) @db.Decimal(18, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  dueDate       String        @default("")
  notes         String        @default("")
  planId        String
  plan          WeddingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model PlannerRecord {
  id        String            @id @default(cuid())
  kind      PlannerRecordKind
  data      Json
  planId    String
  plan      WeddingPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([planId, kind])
}
